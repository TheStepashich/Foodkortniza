<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Foodkomfort" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:colorBackground">@color/bar_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:editTextStyle">@style/Widget.Foodkomfort.EditText</item>
        <item name="android:windowAnimationStyle">@style/NoActivityAnimations</item>
    </style>

    <style name="Widget.Foodkomfort.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>
